{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "API for optimizing Tokyo commute times based on real-time transit, weather, and crowding data",
        "title": "Tokyo Commute Optimizer API",
        "contact": {
            "name": "API Support"
        },
        "version": "1.0"
    },
    "host": "localhost:3000",
    "basePath": "/",
    "paths": {
        "/api/calculate-route": {
            "post": {
                "description": "Calculates the best routes and departure times based on multiple factors including delays, weather, and crowding. Optionally specify the earliest time you can leave.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "routes"
                ],
                "summary": "Calculate optimized routes",
                "parameters": [
                    {
                        "description": "Route calculation request with optional earliest departure time",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.RouteRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.RouteResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/delays": {
            "get": {
                "description": "Returns current delay information for Tokyo trains from ODPT API",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transit"
                ],
                "summary": "Get current train delays",
                "responses": {
                    "200": {
                        "description": "delays",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/weather": {
            "get": {
                "description": "Returns current weather conditions in Tokyo from Open-Meteo JMA API",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "weather"
                ],
                "summary": "Get current weather",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.WeatherInfo"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns the health status of the API",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.CrowdingInfo": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "level": {
                    "description": "\"LOW\", \"MODERATE\", \"HIGH\", \"VERY_HIGH\"",
                    "type": "string"
                }
            }
        },
        "models.DelayInfo": {
            "type": "object",
            "properties": {
                "delayMinutes": {
                    "type": "integer"
                },
                "lineName": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "status": {
                    "description": "\"NORMAL\", \"DELAYED\", \"SUSPENDED\"",
                    "type": "string"
                }
            }
        },
        "models.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "error": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "models.FactorInfo": {
            "type": "object",
            "properties": {
                "crowdingEstimate": {
                    "$ref": "#/definitions/models.CrowdingInfo"
                },
                "delays": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.DelayInfo"
                    }
                },
                "weather": {
                    "$ref": "#/definitions/models.WeatherInfo"
                }
            }
        },
        "models.LineInfo": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "shortName": {
                    "type": "string"
                },
                "vehicle": {
                    "description": "\"SUBWAY\", \"TRAIN\", \"BUS\"",
                    "type": "string"
                }
            }
        },
        "models.Route": {
            "type": "object",
            "properties": {
                "breakdown": {
                    "$ref": "#/definitions/models.TimeBreakdown"
                },
                "score": {
                    "type": "number"
                },
                "steps": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.RouteStep"
                    }
                },
                "summary": {
                    "type": "string"
                },
                "totalTime": {
                    "description": "in seconds",
                    "type": "integer"
                }
            }
        },
        "models.RouteRequest": {
            "type": "object",
            "required": [
                "destination",
                "origin"
            ],
            "properties": {
                "departureTime": {
                    "type": "string"
                },
                "destination": {
                    "type": "string"
                },
                "earliestDepartureTime": {
                    "type": "string"
                },
                "origin": {
                    "type": "string"
                }
            }
        },
        "models.RouteResponse": {
            "type": "object",
            "properties": {
                "factors": {
                    "$ref": "#/definitions/models.FactorInfo"
                },
                "optimalDepartureTime": {
                    "type": "string"
                },
                "routes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Route"
                    }
                }
            }
        },
        "models.RouteStep": {
            "type": "object",
            "properties": {
                "arriveAt": {
                    "description": "for TRANSIT steps",
                    "type": "string"
                },
                "departAt": {
                    "description": "for TRANSIT steps",
                    "type": "string"
                },
                "distance": {
                    "description": "in meters",
                    "type": "integer"
                },
                "duration": {
                    "description": "in seconds",
                    "type": "integer"
                },
                "instructions": {
                    "type": "string"
                },
                "line": {
                    "description": "for TRANSIT steps",
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.LineInfo"
                        }
                    ]
                },
                "type": {
                    "description": "\"WALK\", \"TRANSIT\", \"WAIT\"",
                    "type": "string"
                }
            }
        },
        "models.TimeBreakdown": {
            "type": "object",
            "properties": {
                "crowdingPenalty": {
                    "description": "in seconds",
                    "type": "integer"
                },
                "delayPenalty": {
                    "description": "in seconds",
                    "type": "integer"
                },
                "transitTime": {
                    "description": "in seconds",
                    "type": "integer"
                },
                "waitingTime": {
                    "description": "in seconds",
                    "type": "integer"
                },
                "walkingTime": {
                    "description": "in seconds",
                    "type": "integer"
                },
                "weatherPenalty": {
                    "description": "in seconds",
                    "type": "integer"
                }
            }
        },
        "models.WeatherInfo": {
            "type": "object",
            "properties": {
                "condition": {
                    "description": "\"CLEAR\", \"RAIN\", \"SNOW\", etc.",
                    "type": "string"
                },
                "lastUpdated": {
                    "type": "string"
                },
                "precipitation": {
                    "description": "in mm/hour",
                    "type": "number"
                },
                "temperature": {
                    "description": "in Celsius",
                    "type": "number"
                }
            }
        }
    }
}