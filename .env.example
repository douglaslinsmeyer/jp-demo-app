# Google Maps API Key
# Get your key at: https://console.cloud.google.com/
# Enable: Routes API, Places API, Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ODPT API Key
# Register at: https://developer.odpt.org/
# Note: Registration takes up to 2 business days
ODPT_API_KEY=your_odpt_api_key_here

# Redis Configuration
REDIS_URL=redis://redis:6379

# Server Configuration
PORT=3000
ENV=development
